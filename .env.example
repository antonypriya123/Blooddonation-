# =======================================================
# BloodConnect Environment Configuration Example
# Copy this file to .env and fill in your actual credentials
# =======================================================

# Railway Cloud MySQL Configuration
DB_HOST=reseau.proxy.rlwy.net
DB_PORT=54263
DB_NAME=railway
DB_USERNAME=root
DB_PASSWORD=your_railway_mysql_password_here

# Server Port
PORT=8080

# Spring Profiles (prod / dev)
SPRING_PROFILES_ACTIVE=prod
